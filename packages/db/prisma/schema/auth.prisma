// Authentication (packages/auth, better-auth). Table and column names follow
// better-auth's core schema so its Prisma adapter can read and write them.

enum UserRole {
  /// A lodge owner or manager, signs in to the dashboard
  OWNER
  /// StayZim staff
  ADMIN
}

model User {
  id                 String    @id
  name               String
  email              String    @unique
  emailVerified      Boolean   @default(false) @map("email_verified")
  image              String?
  role               UserRole  @default(OWNER)
  /// Set when an account is created with a temporary password; the dashboard
  /// stays closed until the owner picks their own.
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  /// A guest account from /create: it owns a demo before the owner gives an email
  /// ("Claim my site"). Its email is a placeholder at GUEST_EMAIL_DOMAIN, never mailed.
  isAnonymous        Boolean   @default(false) @map("is_anonymous")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  sessions           Session[]
  accounts           Account[]
  /// The lodge this owner manages (one per owner for now)
  lodge              Lodge?

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("session")
}

/// A way of signing in. Email and password logins are provider "credential",
/// with the password hash stored here.
model Account {
  id                    String    @id
  /// Who vouches for the identity: "local:credential" for email and password
  issuer                String
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("account")
}

/// Short-lived tokens, e.g. password reset links.
model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

/// Sign-in and reset attempts per IP and path (better-auth's rate limiter), kept here so the
/// limits survive a restart and hold across server instances.
model RateLimit {
  id          String @id
  /// "<ip>|<path>"
  key         String @unique
  count       Int
  /// Milliseconds since 1970 of the window's first request
  lastRequest BigInt @map("last_request")

  @@map("rate_limit")
}
