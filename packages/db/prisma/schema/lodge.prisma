// Lodges (the owner dashboard and, later, {slug}.stayzim.co.zw sites).

enum LodgePlan {
  /// $20/month: the site and the WhatsApp button
  STARTER
  /// $40/month: + visitor analytics and a free .co.zw domain
  GROWTH
  /// $75/month: + we manage Booking.com and Airbnb
  PRO
}

/// Demo (2 days free after sign-up) → Active once paid → Overdue when the paid
/// period ends (the site stays up 3 more days) → Suspended (offline) → Active
/// again once paid. The billing job (apps/server/src/jobs/billing.ts) moves
/// Active → Overdue → Suspended; a payment (Paynow or mark-paid) makes it Active.
enum LodgeStatus {
  /// Self-signed-up and not paid yet: live with "This is a demo" badges until demoEndsAt
  DEMO
  ACTIVE
  OVERDUE
  SUSPENDED
}

model Lodge {
  id           String  @id @default(cuid())
  /// Subdomain, e.g. "mistvalley" for mistvalley.stayzim.co.zw. Also the payment reference.
  slug         String  @unique
  /// The lodge's own domain, e.g. "mistvalleylodge.co.zw" (lowercase, no "www."). Its site answers
  /// there as well as on the subdomain. Set by StayZim with scripts/set-domain.ts.
  customDomain String? @unique @map("custom_domain")
  name         String
  /// Short intro at the top of the site
  description  String  @default("")
  /// e.g. "Nyanga"
  town         String?
  /// e.g. "Manicaland"
  region       String?

  /// Digits only with country code, e.g. 263771234567. Every Book on WhatsApp button opens this chat.
  whatsapp String?
  /// Digits only with country code, for guests who prefer to call
  phone    String?
  email    String?

  /// The share link from Google Maps, as pasted
  mapsUrl   String? @map("maps_url")
  latitude  Float?
  longitude Float?

  /// Site template key from @stayzim/sites. Null: the plan's default.
  template     String? @map("template")
  /// The owner's own hero text. Null: the template's default copy.
  heroHeadline String? @map("hero_headline")
  heroSubline  String? @map("hero_subline")

  /// Guest info (docs/cms/guest-info.md). Times as "14:00".
  checkInFrom         String? @map("check_in_from")
  checkOutBy          String? @map("check_out_by")
  /// string[], up to 10
  houseRules          Json    @default("[]") @map("house_rules")
  cancellationPolicy  String? @map("cancellation_policy")
  /// { q: string; a: string }[], up to 8
  faq                 Json    @default("[]")
  /// { facebook?: url, instagram?: url, … }
  socialLinks         Json    @default("{}") @map("social_links")
  /// Booking requests from the site are confirmed straight away when the nights are free (Growth and Pro)
  autoConfirmBookings Boolean @default(false) @map("auto_confirm_bookings")

  /// Headings, prices and links on the site, e.g. Highland #1E4A3B. The WhatsApp button stays green.
  themeColor  String  @default("#1E4A3B") @map("theme_color")
  /// Path under the upload directory, like Photo.key
  logoKey     String? @map("logo_key")
  /// The big photo at the top of the site. Defaults to the first gallery photo.
  heroPhotoId String? @unique @map("hero_photo_id")
  heroPhoto   Photo?  @relation("LodgeHero", fields: [heroPhotoId], references: [id], onDelete: SetNull)

  plan       LodgePlan   @default(GROWTH)
  status     LodgeStatus @default(DEMO)
  /// When a demo's site goes offline (DEMO only; cleared once paid)
  demoEndsAt DateTime?   @map("demo_ends_at")
  /// End of the period the last payment covers
  paidUntil  DateTime?   @map("paid_until")

  /// Set the first time the owner copies or shares their link (setup checklist)
  linkSharedAt DateTime? @map("link_shared_at")

  ownerId String @unique @map("owner_id")
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  rooms    Room[]
  photos   Photo[]         @relation("LodgePhotos")
  events   SiteEvent[]
  requests ChangeRequest[]
  invoices Invoice[]
  payments Payment[]
  bookings Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("lodge")
}

model Room {
  id          String    @id @default(cuid())
  lodgeId     String    @map("lodge_id")
  lodge       Lodge     @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  name        String
  /// USD per night, whole dollars
  price       Int
  sleeps      Int       @default(2)
  /// Keys from the amenity list in @stayzim/sites, e.g. ["wifi", "braai"]
  amenities   String[]  @default([])
  /// Order on the site, from 0
  position    Int       @default(0)
  /// Optional details guests see on the room card
  description String?
  /// "1 queen + 2 singles"
  beds        String?
  /// Square metres
  size        Int?
  /// How many of this room the lodge has ("Standard Room × 6"); bookings use it
  units       Int       @default(1)
  /// false: hidden from the site, kept in the dashboard
  visible     Boolean   @default(true)
  photos      Photo[]
  bookings    Booking[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([lodgeId, position])
  @@map("room")
}

/// A photo on the lodge site. In the gallery when `roomId` is null, on a room's card otherwise.
model Photo {
  id      String  @id @default(cuid())
  lodgeId String  @map("lodge_id")
  lodge   Lodge   @relation("LodgePhotos", fields: [lodgeId], references: [id], onDelete: Cascade)
  roomId  String? @map("room_id")
  room    Room?   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  heroOf  Lodge?  @relation("LodgeHero")

  /// Path under the upload directory, e.g. "lodges/<lodgeId>/<id>.jpg"
  key       String  @unique
  /// Smaller copies made on the owner's phone with the full one, so lodge sites send phones what
  /// they need: at most 1280px (full-width on phones) and 640px (thumbnails) on the longest side,
  /// e.g. "lodges/<lodgeId>/<id>-md.jpg". Null for photos already that small, and older uploads.
  mediumKey String? @map("medium_key")
  smallKey  String? @map("small_key")
  width     Int
  height    Int
  /// Bytes, after resizing on the owner's phone
  size      Int
  caption   String  @default("")
  /// Order in the gallery or on the room, from 0
  position  Int     @default(0)

  createdAt DateTime @default(now()) @map("created_at")

  @@index([lodgeId, roomId, position])
  @@map("photo")
}

enum ChangeRequestTopic {
  TEXT
  PHOTOS
  ROOMS
  DESIGN
  OTHER
}

enum ChangeRequestStatus {
  OPEN
  IN_PROGRESS
  DONE
  DECLINED
}

/// Something the owner can't edit themselves, asked of StayZim. Also sent on
/// WhatsApp; StayZim updates the status (scripts/resolve-request.ts).
model ChangeRequest {
  id         String              @id @default(cuid())
  /// Short code the owner and StayZim both quote, e.g. "R-7K2Q"
  reference  String              @unique
  lodgeId    String              @map("lodge_id")
  lodge      Lodge               @relation(fields: [lodgeId], references: [id], onDelete: Cascade)
  topic      ChangeRequestTopic
  message    String
  status     ChangeRequestStatus @default(OPEN)
  /// StayZim's note back to the owner, e.g. what was changed
  reply      String?
  createdAt  DateTime            @default(now()) @map("created_at")
  updatedAt  DateTime            @updatedAt @map("updated_at")
  resolvedAt DateTime?           @map("resolved_at")

  @@index([lodgeId, createdAt])
  @@map("change_request")
}
