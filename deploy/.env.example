# Settings for deploy/compose.yaml. In Coolify, paste these into the resource's
# Environment Variables; for plain Docker, copy this file to deploy/.env.
# docs/deployment.md explains each one.

# --- Required ---
# Postgres password for the bundled database (openssl rand -hex 24)
POSTGRES_PASSWORD=
# 32+ random characters (openssl rand -base64 32). Changing it signs everyone out.
BETTER_AUTH_SECRET=

# --- Addresses (the defaults are production) ---
# Build-time: baked into the web app. Changing them needs a redeploy with a rebuild.
NEXT_PUBLIC_SERVER_URL=https://api.stayzim.co.zw
NEXT_PUBLIC_SITES_DOMAIN=stayzim.co.zw
# StayZim's sales WhatsApp number, digits only with the country code
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Meta (Facebook) Pixel ID for the ads (optional; empty: no Pixel). Build-time, like the rest.
NEXT_PUBLIC_META_PIXEL_ID=

CORS_ORIGIN=https://app.stayzim.co.zw,https://stayzim.co.zw
SITES_DOMAIN=stayzim.co.zw
BETTER_AUTH_URL=https://api.stayzim.co.zw
WEB_URL=https://app.stayzim.co.zw
COOKIE_DOMAIN=.stayzim.co.zw
# Behind Cloudflare (recommended). Use x-forwarded-for if the site isn't proxied by Cloudflare.
CLIENT_IP_HEADER=cf-connecting-ip

# --- Lodge photos: Cloudflare R2 (required in production) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stayzim-media
R2_PUBLIC_URL=https://media.stayzim.co.zw
# Only for buckets in R2's EU jurisdiction:
# R2_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com

# --- Email (password resets), e.g. Spacemail ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=hello@stayzim.co.zw
SMTP_PASS=
SMTP_FROM=StayZim <hello@stayzim.co.zw>

# --- Paynow (online payments; result URL: https://api.stayzim.co.zw/api/paynow/result) ---
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
# Only while the Paynow integration is in test mode
PAYNOW_AUTH_EMAIL=

# --- Paying outside Paynow: merchant codes shown on Billing (empty: not shown) ---
ECOCASH_MERCHANT_CODE=
INNBUCKS_MERCHANT_CODE=

# --- Who issues invoices and receipts ---
BUSINESS_NAME=StayZim
# Address lines separated by "|"
BUSINESS_ADDRESS=Mutare, Zimbabwe
BUSINESS_EMAIL=hello@stayzim.co.zw
# Tax or business registration number (printed when set)
BUSINESS_TAX_NUMBER=

# --- Sign in with Google (optional; leave empty to hide the button) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
