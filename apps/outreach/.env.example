CORS_ORIGIN=http://localhost:3001
PORT=9997
# Required on every /api request as "Authorization: Bearer <password>".
# Also the password for the pages (/dashboard, /accounts, ...; username: admin).
OUTREACH_PASSWORD=change-me

# Same Postgres as apps/server: contacts, outreach log and WhatsApp sessions
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stayzim

WHATSAPP_ENABLED=true
# One linked number per id (each gets its own Chrome + its own whatsapp_session row)
WHATSAPP_ACCOUNTS=wa1,wa2,wa3
# Max messages per number per rolling 24h. 40 is safe for new numbers; raise slowly for warmed-up ones
WHATSAPP_DAILY_LIMIT=40
# Scratch dir for live Chrome profiles + backup zips; Postgres is the source of truth
WHATSAPP_SESSION_PATH=./.wwebjs_auth
# Optional: auto-detected (system Chromium on Linux, Chrome on Windows/macOS)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
