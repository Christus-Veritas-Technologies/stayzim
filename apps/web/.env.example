# Public URL of the API (apps/server). Baked into the build: pass it as a build arg in Docker.
NEXT_PUBLIC_SERVER_URL=http://localhost:9998
# StayZim's sales and support WhatsApp number, digits only with the country code.
# Every WhatsApp button on the landing page and in the dashboard opens a chat with it.
# NEXT_PUBLIC_WHATSAPP_NUMBER=263771234567
# Lodge sites are {slug}.NEXT_PUBLIC_SITES_DOMAIN. Production: stayzim.co.zw.
# Locally, http://mistvalley.localhost:9999 opens the lodge with slug "mistvalley".
NEXT_PUBLIC_SITES_DOMAIN=localhost:9999
# Optional: how the web server reaches the API from the inside, e.g. http://server:9998 in
# Docker, so lodge site pages don't fetch through the public internet. Defaults to
# NEXT_PUBLIC_SERVER_URL.
# SERVER_INTERNAL_URL=http://localhost:9998
# The Meta (Facebook) Pixel is built in (its ID is in src/lib/meta-pixel.ts) and loads
# on StayZim's own pages in production builds only; lodge sites never load it. "off"
# leaves it out of a production build (CI's browser tests do this).
# NEXT_PUBLIC_META_PIXEL=off

# IndexNow: the same key as the API's INDEXNOW_KEY, served at /indexnow-key.txt on every
# lodge host. Unset: the file 404s and the API doesn't ping.
# INDEXNOW_KEY=
