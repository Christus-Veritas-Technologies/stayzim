# Public URL of the API (apps/server). Baked into the build: pass it as a build arg in Docker.
NEXT_PUBLIC_SERVER_URL=http://localhost:9998
# StayZim's sales and support WhatsApp number, digits only with the country code.
# Every WhatsApp button on the landing page and in the dashboard opens a chat with it.
# NEXT_PUBLIC_WHATSAPP_NUMBER=263771234567
# Lodge sites are {slug}.NEXT_PUBLIC_SITES_DOMAIN. Production: stayzim.co.zw.
# Locally, http://mistvalley.localhost:9999 opens the lodge with slug "mistvalley".
NEXT_PUBLIC_SITES_DOMAIN=localhost:9999
