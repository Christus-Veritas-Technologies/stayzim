# apps/admin: the team's app (admin.stayzim.co.zw), on http://localhost:9996 locally.
# Its pages call the API (apps/server) with your team login, like the web app; its own
# server runs the WhatsApp outreach against the main database.

NEXT_PUBLIC_SERVER_URL=http://localhost:9998
NEXT_PUBLIC_WEB_URL=http://localhost:9999
NEXT_PUBLIC_SITES_DOMAIN=localhost:9999

# The main database (the same as apps/server's)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stayzim
# @stayzim/db reads the API's settings too: the admin's own address is enough
CORS_ORIGIN=http://localhost:9996

# For scripts calling /api/outreach/* without a browser: "Authorization: Bearer <token>"
ADMIN_API_TOKEN=change-me-to-something-long

# WhatsApp outreach: one linked number per id, each with its own Chrome
WHATSAPP_ENABLED=true
WHATSAPP_ACCOUNTS=wa1,wa2,wa3
WHATSAPP_DAILY_LIMIT=40
WHATSAPP_SESSION_PATH=./.wwebjs_auth
# Optional: found by itself (Chromium on Linux, Chrome on Windows and macOS)
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

# Once only, on the first deploy: copy contacts, messages and WhatsApp logins from the
# old outreach database (pnpm --filter admin import-outreach does it by hand)
# OUTREACH_IMPORT_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stayzim-outreach
