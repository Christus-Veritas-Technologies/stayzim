PORT=9998
# The web app's origin (apps/web); requests with cookies are only accepted from here
CORS_ORIGIN=http://localhost:9999
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stayzim

# Auth (packages/auth)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public URL of this API
BETTER_AUTH_URL=http://localhost:9998
# Public URL of the web app (login and reset-password pages)
WEB_URL=http://localhost:9999
# Production only: share the session cookie between api. and app. subdomains
# COOKIE_DOMAIN=.stayzim.co.zw

# Email (packages/mail). Leave SMTP_HOST unset to print emails to the console instead.
# Port 465 uses TLS from the start; 587 upgrades with STARTTLS.
# SMTP_HOST=mail.spacemail.com
# SMTP_PORT=465
# SMTP_USER=hello@stayzim.co.zw
# SMTP_PASS=
# SMTP_FROM=StayZim <hello@stayzim.co.zw>
