PORT=9998
# Web app origins, comma-separated (prod: https://stayzim.co.zw)
CORS_ORIGIN=http://localhost:9999
# Lodge sites are {slug}.SITES_DOMAIN (prod: stayzim.co.zw). Locally, open http://mistvalley.localhost:9999
SITES_DOMAIN=localhost:9999
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/stayzim

# Auth (packages/auth)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public URL of this API
BETTER_AUTH_URL=http://localhost:9998
# Public URL of the web app (login and reset-password pages)
WEB_URL=http://localhost:9999
# Production only: share the session cookie between api. and app. subdomains
# COOKIE_DOMAIN=.stayzim.co.zw
# The header with the visitor's real IP, set by the proxy in front of the API. Behind
# Cloudflare: cf-connecting-ip (visitors can fake the first X-Forwarded-For entry).
# CLIENT_IP_HEADER=cf-connecting-ip

# Sign in with Google (optional; leave empty to hide the button). Google Cloud Console >
# APIs & Services > Credentials > OAuth client ID (Web application), with
#   Authorised JavaScript origin:  http://localhost:9999            (prod: https://stayzim.co.zw)
#   Authorised redirect URI:       http://localhost:9998/api/auth/callback/google
#                                  (prod: https://api.stayzim.co.zw/api/auth/callback/google)
# It only signs in owners whose account email matches; it never creates accounts.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lodge photos and logos: Cloudflare R2 (required in production).
# Create a bucket, give it a public custom domain, and an API token with
# Object Read & Write on that bucket (R2 > Manage API tokens).
R2_ACCOUNT_ID=
# Only for buckets in R2's EU jurisdiction (or another S3-compatible store):
# R2_ENDPOINT=https://<account id>.eu.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=stayzim-media
# The bucket's public URL, e.g. https://cdn.stayzim.co.zw (or its https://pub-….r2.dev URL)
R2_PUBLIC_URL=
# Development only: with the R2 settings empty, photos are saved here and served at /uploads
# UPLOAD_DIR=uploads

# development (the default), production or test. The Docker image sets production.
# NODE_ENV=development

# Email (packages/mail). Leave SMTP_HOST unset to print emails to the console instead.
# Sends password resets, welcome emails, invoices and receipts, and booking emails
# (new bookings to owners; confirmations and cancellations to guests who gave an email).
# Port 465 uses TLS from the start; 587 upgrades with STARTTLS.
# The main sender (no-reply): password resets, welcome emails, booking notices.
# Replies to every StayZim email go to hello@stayzim.co.zw.
# SMTP_HOST=mail.spacemail.com
# SMTP_PORT=465
# SMTP_USER=no-reply@stayzim.co.zw
# SMTP_PASS=
# SMTP_FROM=StayZim <no-reply@stayzim.co.zw>
# Invoices, payment reminders and receipts, from billing@ (host and port default to the ones above).
# Without BILLING_SMTP_USER they go from the main sender.
# BILLING_SMTP_USER=billing@stayzim.co.zw
# BILLING_SMTP_PASS=
# BILLING_SMTP_FROM=StayZim Billing <billing@stayzim.co.zw>
# BILLING_SMTP_HOST=
# BILLING_SMTP_PORT=

# --- Paynow (online payments) ---
# From Paynow: Merchant account → Receive payments → Integration ID and key.
# Without them, owners pay with the merchant codes and StayZim records it (mark-paid).
# PAYNOW_INTEGRATION_ID=
# PAYNOW_INTEGRATION_KEY=
# Test mode only: payments must use your Paynow account's email
# PAYNOW_AUTH_EMAIL=you@stayzim.co.zw
# Tests only: a stand-in for Paynow's API (the default is https://www.paynow.co.zw)
# PAYNOW_API_URL=http://localhost:9091

# --- Paying outside Paynow ---
# Shown on Billing for owners who pay to a merchant code (then mark-paid records it).
# A method without a code isn't shown.
# ECOCASH_MERCHANT_CODE=
# INNBUCKS_MERCHANT_CODE=
