{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "@stayzim/auth": "workspace:*",
    "@stayzim/db": "workspace:*",
    "@stayzim/env": "workspace:*",
    "@stayzim/mail": "workspace:*",
    "@stayzim/sites": "workspace:*",
    "dotenv": "^17.2.2",
    "hono": "^4.8.2",
    "hono-rate-limiter": "^0.5.4",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@stayzim/config": "workspace:*",
    "@types/bun": "^1.3.4",
    "tsdown": "^0.21.9",
    "typescript": "^6.0.0"
  }
}
